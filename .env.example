# 基础设施凭据示例 —— 复制为 .env 后填写真实值：
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env
# 也可直接运行 start.ps1（首次运行会自动生成随机凭据并写入 .env）。
# 注意：.env 已被 gitignore，切勿提交真实凭据。
MYSQL_ROOT_PASSWORD=change-me-root-password
RABBITMQ_USER=agent-mq
RABBITMQ_PASSWORD=change-me-rabbit-password
MINIO_ROOT_USER=agent-minio
MINIO_ROOT_PASSWORD=change-me-minio-password
REDIS_PASSWORD=change-me-redis-password
